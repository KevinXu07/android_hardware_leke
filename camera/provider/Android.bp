cc_library_shared {
    name: "android.hardware.camera.provider@2.4-impl.leke",
    defaults: ["hidl_defaults"],
    proprietary: true,
    srcs: ["CameraProvider.cpp"],
    shared_libs: [
        "libhidlbase", "libhidltransport", "libutils", "libcutils",
        "android.hardware.camera.device@1.0", "android.hardware.camera.device@3.2",
        "android.hardware.camera.device@3.3", "camera.device@1.0-impl.leke",
        "camera.device@3.2-impl", "camera.device@3.3-impl",
        "android.hardware.camera.provider@2.4", "android.hardware.camera.common@1.0",
        "android.hardware.graphics.mapper@2.0", "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0", "liblog", "libhardware", "libcamera_metadata"
    ],
    static_libs: ["android.hardware.camera.common@1.0-helper"],
    product_variables: {
        lineage: {
            uses_qti_camera_device: {
                cppflags: ["-DQTI_CAMERA_DEVICE"],
                shared_libs: ["vendor.qti.hardware.camera.device@1.0_vendor"],
            },
        },
    },
}
